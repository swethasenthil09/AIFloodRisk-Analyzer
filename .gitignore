# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environment variables & secrets (keep .env.example tracked)
.env
.env.local
.env.*.local
*.env
!.env.example

# Local SQLite databases & temporary data dumps
*.db
*.sqlite
*.sqlite3
flood_risk.db

# Node / Frontend dependencies and production build outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Unit test & coverage reports / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# IDEs & Editor configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Operating System files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
