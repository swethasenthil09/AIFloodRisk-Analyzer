# ==============================================================================
# AI-Based Localized Urban Flood Risk & Early Warning System - Configuration
# Coimbatore City Municipal Corporation (100 Wards)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMS GATEWAY SETTINGS - SMSHORIZON (India Real Mobile SMS Gateway)
# ------------------------------------------------------------------------------
# Choose mode: "live" for real SMS to mobile phones, or "simulator" for testing
SMS_MODE=live

# Gateway provider: "smshorizon" (Default) or "simulator"
SMS_PROVIDER=smshorizon

# SMSHORIZON CREDENTIALS:
# 1. Register / Log in at https://www.smshorizon.in
# 2. Go to My Account / API section to find your Username and API Key
# 3. Enter your approved 6-character Sender ID (e.g. MYTEXT, CCMCCN)
# 4. (Optional) DLT Content Template ID (TID) if required by your SMSHorizon plan route
SMSHORIZON_USER=your_smshorizon_username
SMSHORIZON_API_KEY=your_smshorizon_api_key
SMSHORIZON_SENDER_ID=MYTEXT
SMSHORIZON_TID=

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default is SQLite (Zero-configuration: automatically creates flood_risk.db)
# Set USE_MYSQL=true only if you have a local or cloud MySQL server running
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=flood_risk_db

# ------------------------------------------------------------------------------
# 3. METEOROLOGICAL TELEMETRY
# ------------------------------------------------------------------------------
# Open-Meteo WMO-Certified Weather API is completely open & free. No API key needed!
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
